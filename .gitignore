_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
vendor/
.bundle/
Gemfile.lock
.DS_Store
Thumbs.db
node_modules/

# Source files kept outside the site; not for publishing
/source-docs/
/source-docs/**
*.docx
*.m4a
*.mp4
*.vtt

# …except the site's own compressed video loops (small, publishable)
!assets/video/*.mp4
# …and the compressed clips inside unlisted decks (~6 MB each set)
!decks/*/assets/*.mp4

# local pre-reskin backup (do not publish)
_backup_pre-reskin*/
assets/img/.wtest

# Python
__pycache__/
*.pyc

# wrangler local state (worker deploys)
.wrangler/
