# ── WhatsApp ─────────────────────────────────────────
# Group JID: run `npm run list-groups` after first QR login
WA_GROUP_JID=1203630XXXXXXXXX@g.us
# Poll: options offered every Wednesday (IST times for Sunday's class)
POLL_OPTIONS=10:00 AM,11:00 AM,4:00 PM,7:00 PM
POLL_QUESTION=Sunday class — what time works?
POLL_CRON=0 10 * * 3            # Wed 10:00 IST
TALLY_CRON=0 10 * * 5           # Fri 10:00 IST (48h later)
TZ=Asia/Kolkata

# ── Zoom (Server-to-Server OAuth app: marketplace.zoom.us) ──
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER=me                    # or the prof's zoom email if app lives on his account
SESSION_DURATION_MIN=120

# ── Anthropic (BIL + notes generation) ──────────────
ANTHROPIC_API_KEY=
NOTES_MODEL=claude-sonnet-5
BIL_MODEL=claude-sonnet-5

# ── BIL service ──────────────────────────────────────
BIL_PORT=8047
BIL_TOKEN=change-me-long-random   # bearer token; Firebase function uses this
CORPUS_DIR=./corpus               # gitignored; sync course texts here
INDEX_FILE=./corpus/index.json

# ── Cloudflare Stream ────────────────────────────────
CF_ACCOUNT_ID=
CF_STREAM_TOKEN=

# ── Pipeline ─────────────────────────────────────────
REPO_DIR=..                       # path to the site repo clone on the VPS
ANNOUNCE_URL=http://127.0.0.1:8048/announce
ANNOUNCE_TOKEN=change-me-too
ANNOUNCE_PORT=8048
SITE_BASE=https://genz-economics.com
